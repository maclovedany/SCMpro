# Supabase → Settings → Database → Connection string (URI)   (실제 값은 engine/.env 에 — git 제외)
SUPABASE_DB_URL=
SQLITE_PATH=../data/raw/scm.db

# OpenAI (D-017, R-AI-01). 서버 전용
OPENAI_API_KEY=

# 이메일 발송 (R-SCH-30, Q-019). 비우면 이메일 알림은 skipped 처리
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
